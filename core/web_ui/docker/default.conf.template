# Rendered by the nginx image's entrypoint with envsubst, which fills in PORT.

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    # Behind an ingress the listen port is not the public one.
    absolute_redirect off;

    location = /healthz {
        default_type text/plain;
        return 200 'ok';
    }

    # Browsers ask for this whatever icon the page declares, so the miss is
    # expected and not worth an error log line on every visit.
    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = / {
        return 302 /ui/;
    }

    location = /ui {
        return 302 /ui/;
    }

    # File names carry a content hash, so a cached copy never goes stale.
    location /ui/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Unknown paths are client-side routes, so they get the app shell.
    location /ui/ {
        add_header Cache-Control "no-cache";
        try_files $uri /ui/index.html;
    }
}
